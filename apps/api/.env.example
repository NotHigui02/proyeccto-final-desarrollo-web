# Copie este archivo como .env (NUNCA lo suba a Git). Solo valores de ejemplo.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# Firebase Admin SDK (spec 10). En Vercel, FIREBASE_PRIVATE_KEY lleva \n literales.
FIREBASE_PROJECT_ID=PROJECT_ID_PLACEHOLDER
FIREBASE_CLIENT_EMAIL=CLIENT_EMAIL_PLACEHOLDER
FIREBASE_PRIVATE_KEY="PRIVATE_KEY_PLACEHOLDER"

# Vercel Blob (spec 12)
BLOB_READ_WRITE_TOKEN=BLOB_TOKEN_PLACEHOLDER
