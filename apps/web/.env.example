# Configuración web de Firebase: es PÚBLICA por diseño (queda en el JS del navegador).
# Nunca ponga aquí secretos: todo lo que empiece por VITE_ lo descarga cualquiera.
VITE_FIREBASE_API_KEY=API_KEY_PLACEHOLDER
VITE_FIREBASE_AUTH_DOMAIN=AUTH_DOMAIN_PLACEHOLDER
VITE_FIREBASE_PROJECT_ID=PROJECT_ID_PLACEHOLDER
VITE_FIREBASE_APP_ID=APP_ID_PLACEHOLDER
