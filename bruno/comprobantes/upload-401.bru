meta {
  name: Upload token (401)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/comprobantes/upload
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: http://localhost:5173
}

body:json {
  {
    "type": "blob.generate-client-token",
    "payload": {
      "pathname": "usuarios/demo/comprobantes/a.pdf",
      "multipart": false,
      "clientPayload": null
    }
  }
}
