meta {
  name: Crear sesión
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sesion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: http://localhost:5173
}

body:json {
  {
    "idToken": "{{idToken}}"
  }
}

docs {
  Registro de sesión con idToken de Firebase Auth. Respuesta 204 + Set-Cookie.
}
